---
import { SITE, NAV } from "../site";
import { url } from "../utils/url";

const path = Astro.url.pathname;
const home = url("/");
const overlay = path === home;
const links = (NAV || []).map((item) => {
  const external = /^https?:/i.test(item.url);
  return {
    href: external ? item.url : url(item.url),
    label: item.label,
    external,
    active: !external && (item.url === "/" ? path === home : path.startsWith(url(item.url))),
  };
});
---
<header class={overlay ? "site-header overlay" : "site-header"}>
  <div class="wrap header-inner">
    <a class="brand" href={home}><span class="brand-mark">S</span>{SITE.author}</a>
    <nav class="nav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          class={link.active ? "nav-link active" : "nav-link"}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
      <a class="nav-icon search-icon" href={url("/search/")} aria-label="搜索">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <a class="nav-icon github-icon" href={SITE.repo} target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor"><path d="M12 .8a11.2 11.2 0 0 0-3.5 21.8c.6.1.8-.2.8-.5v-1.9c-3.1.7-3.8-1.4-3.8-1.4-.5-1.3-1.2-1.6-1.2-1.6-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.3-5.1-5.6 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-3 0 0 .9-.3 3 1.1a10.4 10.4 0 0 1 5.5 0c2.1-1.4 3-1.1 3-1.1.6 1.6.2 2.7.1 3 .7.8 1.1 1.8 1.1 3 0 4.3-2.6 5.3-5.1 5.6.4.3.7 1 .7 2v2.9c0 .3.2.6.8.5A11.2 11.2 0 0 0 12 .8Z"/></svg>
      </a>
    </nav>
  </div>
</header>
