---
import { url } from "../utils/url";

const path = Astro.url.pathname;
const home = url("/");
const links = [
  { href: home, label: "首页" },
  { href: url("/archive/"), label: "归档" },
  { href: url("/tags/"), label: "标签" },
  { href: url("/search/"), label: "搜索" },
  { href: url("/about/"), label: "关于" },
];
const isActive = (href: string) =>
  href === home ? path === home : path.startsWith(href);
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={home}>Soren<span>X</span></a>
    <nav class="nav" aria-label="主导航">
      {links.map((link) => (
        <a href={link.href} class={isActive(link.href) ? "nav-link active" : "nav-link"}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
