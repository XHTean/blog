    <span>© {year} {SITE.author}</span>
    <span>·</span>
    <a href={url("/rss.xml")}>RSS</a>
    <span>·</span>
    <a href={SITE.repo} target="_blank" rel="noreferrer">GitHub</a>
    <span>·</span>
    <a href="https://app.pagescms.org" target="_blank" rel="noreferrer">后台</a>
    <span>·</span>
    <span>MADE WITH <b class="heart">♥</b></span>
    <span class="stamp" aria-hidden="true">S</span>
  </div>
</footer>
