---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Giscus from "../../components/Giscus.astro";
import { url } from "../../utils/url";
import { formatDate } from "../../utils/date";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index - 1] ?? null,
      next: posts[index + 1] ?? null,
    },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
  prev: CollectionEntry<"posts"> | null;
  next: CollectionEntry<"posts"> | null;
};

const { post, prev, next } = Astro.props as Props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth <= 3);
const chars = (post.body ?? "").replace(/\s+/g, "").length;
const minutes = Math.max(1, Math.round(chars / 400));
---
<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <div class="reading-progress" aria-hidden="true"><span data-progress></span></div>

  <div class="wrap">
    <div class="post-layout">
      <article class="article">
        <span class="article-kicker">● ARTICLE</span>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>约 {minutes} 分钟</span>
          <span>阅读 <span id="busuanzi_value_page_pv">—</span></span>
          {post.data.tags.map((tag) => (
            <a class="tag" href={url(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
          ))}
        </div>

        {post.data.description && <p class="article-lead">{post.data.description}</p>}

        <div class="share-row">
          <button class="share-btn" type="button" data-share>复制链接</button>
          <a class="share-btn" href={url("/archive/")}>看归档</a>
          <a class="share-btn" href={url("/tags/")}>看标签</a>
          <button class="share-btn" type="button" data-like>♡ 点赞</button>
        </div>

        <div class="prose">
          <Content />
        </div>

        <nav class="post-nav" aria-label="上一篇和下一篇">
          {prev ? <a href={url(`/posts/${prev.id}/`)}>← {prev.data.title}</a> : <span></span>}
          {next ? <a class="next" href={url(`/posts/${next.id}/`)}>{next.data.title} →</a> : <span></span>}
        </nav>

        <Giscus />
      </article>

      {toc.length > 0 && (
        <aside class="toc" aria-label="文章目录">
          <h2>ON THIS PAGE</h2>
          <ol>
            {toc.map((heading) => (
              <li data-depth={heading.depth}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </div>

  <script>
    (function () {
      var bar = document.querySelector("[data-progress]");
      function update() {
        if (!bar) return;
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var p = max > 0 ? (window.scrollY / max) * 100 : 0;
        bar.style.width = Math.min(100, Math.max(0, p)) + "%";
      }
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);

      var like = document.querySelector("[data-like]");
      if (like) {
        var key = "liked:" + window.location.pathname;
        var liked = false;
        try { liked = localStorage.getItem(key) === "1"; } catch (e) {}
        like.textContent = liked ? "♥ 已赞" : "♡ 点赞";
        like.addEventListener("click", function () {
          liked = !liked;
          try {
            if (liked) localStorage.setItem(key, "1");
            else localStorage.removeItem(key);
          } catch (e) {}
          like.textContent = liked ? "♥ 已赞" : "♡ 点赞";
        });
      }

      var share = document.querySelector("[data-share]");
      if (share) {
        share.addEventListener("click", async function () {
          var text = share.textContent;
          try {
            await navigator.clipboard.writeText(window.location.href);
            share.textContent = "已复制";
          } catch (e) {
            share.textContent = "复制失败";
          }
          setTimeout(function () { share.textContent = text; }, 1600);
        });
      }
    })();
  </script>
</BaseLayout>
