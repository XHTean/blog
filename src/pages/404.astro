---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../utils/url";
---
<BaseLayout title="页面不存在" description="404">
  <div class="wrap">
    <section class="page-head">
      <h1>404</h1>
      <p>PAGE NOT FOUND</p>
    </section>
    <div class="page">
      <div class="card">
        <div class="prose">
          <p>这一页不存在，可能被删了，或者地址写错了。</p>
          <p><a href={url("/")}>← 回到首页</a></p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
