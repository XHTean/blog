---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../utils/url";
import { formatDate } from "../utils/date";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const groups = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  if (!groups.has(year)) groups.set(year, []);
  groups.get(year)!.push(post);
}
const years = [...groups.entries()].sort((a, b) => b[0] - a[0]);
---
<BaseLayout title="归档" description="全部文章按年份归档">
  <section class="page-head">
    <h1>归档</h1>
    <p>共 {posts.length} 篇</p>
  </section>

  {years.map(([year, items]) => (
    <section class="archive-group">
      <h2>{year}</h2>
      <ul>
        {items.map((post) => (
          <li>
            <time>{formatDate(post.data.date).slice(5)}</time>
            <a href={url(`/posts/${post.id}/`)}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
