---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../utils/url";
import { formatDate } from "../utils/date";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const groups = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  if (!groups.has(year)) groups.set(year, []);
  groups.get(year)!.push(post);
}
const years = [...groups.entries()].sort((a, b) => b[0] - a[0]);
---
<BaseLayout title="归档" description="全部文章按年份归档">
  <div class="wrap">
    <section class="page-head">
      <h1>归档</h1>
      <p>ARCHIVE / 共 {posts.length} 篇 · <a href={url("/timeline/")}>时间线视图</a></p>
    </section>

    {years.map(([year, items]) => (
      <section class="card year-block">
        <h2>{year} / {items.length} 篇</h2>
        <ul class="year-list">
          {items.map((post) => (
            <li>
              <a href={url(`/posts/${post.id}/`)}>
                <time>{formatDate(post.data.date).slice(5)}</time>
                <span>{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {posts.length === 0 && <p class="empty">// 还没有文章。</p>}
  </div>
</BaseLayout>
