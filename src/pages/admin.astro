---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../utils/url";
---
<BaseLayout title="管理后台" description="博客管理后台" bare noindex>
  <div class="admin-wrap">
    <header class="admin-top">
      <div>
        <p class="admin-kicker">ADMIN / XHTean/blog</p>
        <h1>管理后台</h1>
      </div>
      <div class="admin-top-actions">
        <a class="btn ghost" href={url("/")}>← 回博客</a>
        <button class="btn ghost" id="logout" type="button" hidden>退出</button>
      </div>
    </header>

    <section id="login" class="card admin-login">
      <h2>连接 GitHub</h2>
      <p class="admin-note">
        用只授权 <b>XHTean/blog</b> 的 fine-grained token，权限只需要
        <b>Contents: Read and write</b>。token 只存在这台手机的浏览器里，不会发到别处。
      </p>
      <label class="admin-field">
        GitHub token
        <input type="password" id="token" autocomplete="off" placeholder="github_pat_…">
      </label>
      <label class="admin-check"><input type="checkbox" id="remember"> 记住 7 天（本机 localStorage）</label>
      <button class="btn" id="connect" type="button">连接</button>
      <p class="admin-status" id="login-status" role="status"></p>

      <details class="admin-help">
        <summary>怎么建 token？</summary>
        <ol>
          <li>打开 <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noreferrer">Fine-grained tokens</a></li>
          <li>Repository access 只选 <b>XHTean/blog</b></li>
          <li>Permissions → Contents：<b>Read and write</b></li>
          <li>生成后复制，粘到上面的框里</li>
        </ol>
      </details>
    </section>

    <section id="app" hidden>
      <div class="admin-tabs">
        <button class="admin-tab active" type="button" data-admin-tab="posts">文章</button>
        <button class="admin-tab" type="button" data-admin-tab="settings">站点设置</button>
      </div>

      <div data-admin-panel="posts">
      <div class="admin-toolbar">
        <button class="btn" id="new" type="button">+ 新建文章</button>
        <button class="btn ghost" id="refresh" type="button">刷新</button>
        <span class="admin-status" id="status" role="status"></span>
      </div>

      <div class="admin-grid">
        <aside class="card admin-list">
          <h2>文章</h2>
          <ul id="post-list"></ul>
          <p class="empty" id="list-empty" hidden>还没有文章</p>
        </aside>

        <section class="card admin-editor">
          <form id="form">
            <label class="admin-field">标题
              <input id="title" type="text" required placeholder="文章标题">
            </label>
            <label class="admin-field">文件名 / slug
              <input id="slug" type="text" placeholder="hello-world">
            </label>
            <label class="admin-field">摘要
              <textarea id="description" rows="2" placeholder="一两句话介绍"></textarea>
            </label>
            <div class="row2">
              <label class="admin-field">日期
                <input id="date" type="date" required>
              </label>
              <label class="admin-check"><input type="checkbox" id="draft"> 草稿（不发布）</label>
            </div>
            <label class="admin-field">标签（逗号分隔）
              <input id="tags" type="text" placeholder="随笔, 博客">
            </label>
            <label class="admin-field">正文（Markdown）
              <textarea id="body" rows="14" class="mono" placeholder="在这里写正文…"></textarea>
            </label>
            <div class="admin-actions">
              <button class="btn" type="submit">保存并发布</button>
              <a class="btn ghost" id="view" target="_blank" rel="noreferrer" hidden>查看</a>
              <button class="btn ghost" id="delete" type="button" hidden>删除</button>
              <button class="btn ghost" id="cancel" type="button" hidden>取消编辑</button>
            </div>
          </form>
        </section>
      </div>
      </div>

      <div data-admin-panel="settings" hidden>
        <form id="settings-form" class="card admin-settings">
          <h2>站点设置</h2>
          <p class="admin-note">保存后会提交到 <code>src/data/site.json</code>，约 1 分钟上线。</p>

          <label class="admin-field">站点标题
            <input id="set-title" type="text" required>
          </label>
          <label class="admin-field">副标题
            <input id="set-subtitle" type="text">
          </label>
          <label class="admin-field">站点描述
            <textarea id="set-description" rows="2"></textarea>
          </label>
          <label class="admin-field">作者名
            <input id="set-author" type="text">
          </label>
          <label class="admin-field">个人简介
            <textarea id="set-bio" rows="3"></textarea>
          </label>
          <label class="admin-field">公告
            <textarea id="set-announcement" rows="3"></textarea>
          </label>
          <label class="admin-field">About 文案
            <textarea id="set-about" rows="3"></textarea>
          </label>

          <div class="admin-asset">
            <div class="admin-asset-preview"><img id="preview-avatar" alt="头像预览"></div>
            <div class="admin-asset-body">
              <label class="admin-field">头像路径
                <input id="set-avatar" type="text" placeholder="/uploads/avatar.jpg">
              </label>
              <label class="btn ghost admin-upload">上传新头像
                <input type="file" accept="image/*" data-upload="avatar" hidden>
              </label>
            </div>
          </div>

          <div class="admin-asset">
            <div class="admin-asset-preview banner"><img id="preview-banner" alt="横幅预览"></div>
            <div class="admin-asset-body">
              <label class="admin-field">横幅路径
                <input id="set-banner" type="text" placeholder="/uploads/banner.jpg">
              </label>
              <label class="btn ghost admin-upload">上传新横幅
                <input type="file" accept="image/*" data-upload="banner" hidden>
              </label>
            </div>
          </div>

          <label class="admin-field">导航栏（每行：名称|链接）
            <textarea id="set-nav" rows="5" class="mono"></textarea>
          </label>
          <label class="admin-field">社交链接（每行：名称|链接|图标，图标可选 github / rss / search / settings / mail / bilibili / link）
            <textarea id="set-socials" rows="5" class="mono"></textarea>
          </label>
          <label class="admin-field">GitHub 项目（每行：owner/repo|描述）
            <textarea id="set-repos" rows="4" class="mono"></textarea>
          </label>
          <label class="admin-field">友链（每行：名称|链接|头像|描述）
            <textarea id="set-friends" rows="4" class="mono"></textarea>
          </label>
          <label class="admin-field">相册（每行：图片路径|说明）
            <textarea id="set-gallery" rows="4" class="mono"></textarea>
          </label>
          <label class="btn ghost admin-upload">上传相册图片
            <input type="file" accept="image/*" data-upload="gallery" hidden>
          </label>
          <label class="admin-field">项目（每行：名称|链接|描述）
            <textarea id="set-projects" rows="4" class="mono"></textarea>
          </label>
          <label class="admin-field">音乐（每行：标题|歌手|音频链接）
            <textarea id="set-tracks" rows="4" class="mono"></textarea>
          </label>
          <label class="btn ghost admin-upload">上传音频
            <input type="file" accept="audio/*" data-upload="audio" hidden>
          </label>
          <label class="admin-field">收藏（每行：分类|标题|说明|链接）
            <textarea id="set-collection" rows="4" class="mono"></textarea>
          </label>

          <div class="admin-actions">
            <button class="btn" type="submit">保存设置</button>
            <a class="btn ghost" href={url("/")} target="_blank" rel="noreferrer">看前台</a>
          </div>
          <p class="admin-status" id="settings-status" role="status"></p>
        </form>
      </div>
    </section>
  </div>

  <script>
    (function () {
      var OWNER = "XHTean";
      var REPO = "blog";
      var BRANCH = "main";
      var DIR = "src/content/posts";
      var API = "https://api.github.com";
      var base = location.pathname.replace(/admin\/?$/, "");
      var token = "";
      var current = null;
      var posts = [];
      var slugTouched = false;

      var $ = function (id) { return document.getElementById(id); };
      var login = $("login");
      var app = $("app");
      var loginStatus = $("login-status");
      var statusEl = $("status");

      function setStatus(message, tone) {
        statusEl.textContent = message || "";
        statusEl.setAttribute("data-tone", tone || "");
      }

      function setLoginStatus(message, tone) {
        loginStatus.textContent = message || "";
        loginStatus.setAttribute("data-tone", tone || "");
      }

      function encodePath(path) {
        return path.split("/").map(encodeURIComponent).join("/");
      }

      function b64encode(str) {
        var bytes = new TextEncoder().encode(str);
        var bin = "";
        bytes.forEach(function (b) { bin += String.fromCharCode(b); });
        return btoa(bin);
      }

      function b64decode(str) {
        var bin = atob((str || "").replace(/\s/g, ""));
        var bytes = Uint8Array.from(bin, function (c) { return c.charCodeAt(0); });
        return new TextDecoder().decode(bytes);
      }

      function today() {
        var d = new Date();
        var m = String(d.getMonth() + 1).padStart(2, "0");
        var day = String(d.getDate()).padStart(2, "0");
        return d.getFullYear() + "-" + m + "-" + day;
      }

      function slugify(text) {
        return (text || "")
          .toLowerCase()
          .trim()
          .replace(/[^\p{L}\p{N}]+/gu, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 60);
      }

      function parseFrontmatter(raw) {
        var match = raw.match(/^\uFEFF?---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
        if (!match) return { data: {}, body: raw };
        var data = {};
        match[1].split(/\r?\n/).forEach(function (line) {
          var index = line.indexOf(":");
          if (index < 0) return;
          var key = line.slice(0, index).trim();
          var value = line.slice(index + 1).trim();
          if (!key) return;
          if (value.startsWith("[") && value.endsWith("]")) {
            try { data[key] = JSON.parse(value); }
            catch (e) {
              data[key] = value.slice(1, -1).split(",").map(function (s) {
                return s.trim().replace(/^["']|["']$/g, "");
              }).filter(Boolean);
            }
          } else if (value === "true" || value === "false") {
            data[key] = value === "true";
          } else if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
            try { data[key] = JSON.parse(value); }
            catch (e) { data[key] = value.slice(1, -1); }
          } else {
            data[key] = value;
          }
        });
        return { data: data, body: match[2] };
      }

      function buildContent(data, body) {
        return [
          "---",
          "title: " + JSON.stringify(data.title),
          "description: " + JSON.stringify(data.description || ""),
          "date: " + data.date,
          "tags: " + JSON.stringify(data.tags),
          "draft: " + (data.draft ? "true" : "false"),
          "---",
          "",
          (body || "").replace(/\r\n/g, "\n").trim(),
          ""
        ].join("\n");
      }

      async function api(path, options) {
        options = options || {};
        var headers = {
          Accept: "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28"
        };
        if (token) headers.Authorization = "Bearer " + token;
        if (options.body) headers["Content-Type"] = "application/json";
        var res = await fetch(API + path, {
          method: options.method || "GET",
          headers: headers,
          body: options.body
        });
        if (!res.ok) {
          var err = new Error("HTTP " + res.status);
          err.status = res.status;
          try {
            var payload = await res.json();
            if (payload && payload.message) err.message = payload.message;
          } catch (e) {}
          throw err;
        }
        if (res.status === 204) return null;
        return res.json();
      }

      function getStoredToken() {
        try {
          var session = sessionStorage.getItem("blog_admin_token");
          if (session) return session;
          var local = localStorage.getItem("blog_admin_token");
          var exp = parseInt(localStorage.getItem("blog_admin_exp") || "0", 10);
          if (local && exp > Date.now()) return local;
          localStorage.removeItem("blog_admin_token");
          localStorage.removeItem("blog_admin_exp");
        } catch (e) {}
        return "";
      }

      function storeToken(value, remember) {
        token = value;
        try {
          sessionStorage.setItem("blog_admin_token", value);
          if (remember) {
            localStorage.setItem("blog_admin_token", value);
            localStorage.setItem("blog_admin_exp", String(Date.now() + 7 * 86400000));
          } else {
            localStorage.removeItem("blog_admin_token");
            localStorage.removeItem("blog_admin_exp");
          }
        } catch (e) {}
      }

      function clearToken() {
        token = "";
        try {
          sessionStorage.removeItem("blog_admin_token");
          localStorage.removeItem("blog_admin_token");
          localStorage.removeItem("blog_admin_exp");
        } catch (e) {}
      }

      function showLogin(message, tone) {
        app.hidden = true;
        $("logout").hidden = true;
        login.hidden = false;
        setLoginStatus(message || "", tone);
      }

      function showApp() {
        login.hidden = true;
        app.hidden = false;
        $("logout").hidden = false;
      }

      function renderList() {
        var list = $("post-list");
        list.textContent = "";
        posts.forEach(function (post) {
          var li = document.createElement("li");
          var button = document.createElement("button");
          button.type = "button";
          button.className = "admin-post" + (current && current.path === post.path ? " active" : "");
          var title = document.createElement("b");
          title.textContent = post.data.title || post.name;
          var meta = document.createElement("span");
          meta.textContent = (post.data.date || "") + (post.data.draft ? " · 草稿" : "");
          button.appendChild(title);
          button.appendChild(meta);
          button.addEventListener("click", function () { editPost(post); });
          li.appendChild(button);
          list.appendChild(li);
        });
        $("list-empty").hidden = posts.length > 0;
      }

      async function loadPosts() {
        setStatus("加载中…");
        var items = [];
        try {
          items = await api("/repos/" + OWNER + "/" + REPO + "/contents/" + encodePath(DIR) + "?ref=" + BRANCH);
        } catch (e) {
          if (e.status !== 404) throw e;
        }
        var files = (items || []).filter(function (item) {
          return item.type === "file" && item.name.endsWith(".md");
        });
        posts = await Promise.all(files.map(async function (file) {
          var data = await api("/repos/" + OWNER + "/" + REPO + "/contents/" + encodePath(file.path) + "?ref=" + BRANCH);
          var parsed = parseFrontmatter(b64decode(data.content));
          return {
            name: file.name,
            path: file.path,
            sha: data.sha,
            data: parsed.data,
            body: parsed.body
          };
        }));
        posts.sort(function (a, b) {
          return String(b.data.date || "").localeCompare(String(a.data.date || ""));
        });
        renderList();
        setStatus(posts.length + " 篇文章", "ok");
      }

      function editPost(post) {
        current = { path: post.path, sha: post.sha, slug: post.name.replace(/\.md$/, "") };
        $("title").value = post.data.title || "";
        $("slug").value = current.slug;
        $("slug").disabled = true;
        $("description").value = post.data.description || "";
        $("date").value = String(post.data.date || "").slice(0, 10);
        $("tags").value = (post.data.tags || []).join(", ");
        $("draft").checked = Boolean(post.data.draft);
        $("body").value = post.body || "";
        $("delete").hidden = false;
        $("cancel").hidden = false;
        $("view").hidden = false;
        $("view").href = base + "posts/" + encodeURIComponent(current.slug) + "/";
        setStatus("编辑《" + (post.data.title || post.name) + "》");
        renderList();
      }

      function newPost() {
        current = null;
        slugTouched = false;
        $("form").reset();
        $("slug").disabled = false;
        $("date").value = today();
        $("delete").hidden = true;
        $("cancel").hidden = true;
        $("view").hidden = true;
        setStatus("新文章");
        $("title").focus();
        renderList();
      }

      async function savePost(event) {
        event.preventDefault();
        var title = $("title").value.trim();
        var date = $("date").value;
        var slug = ($("slug").value.trim() || slugify(title) || "post-" + Date.now())
          .replace(/[\/\\]/g, "-");
        if (!title) return setStatus("标题不能为空", "err");
        if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return setStatus("日期格式应为 YYYY-MM-DD", "err");
        var tags = $("tags").value.split(",").map(function (tag) { return tag.trim(); }).filter(Boolean);
        var content = buildContent({
          title: title,
          description: $("description").value.trim(),
          date: date,
          tags: tags,
          draft: $("draft").checked
        }, $("body").value);
        var path = current ? current.path : DIR + "/" + slug + ".md";
        var payload = {
          message: "post: " + title,
          content: b64encode(content),
          branch: BRANCH
        };
        if (current) payload.sha = current.sha;
        setStatus("保存中…");
        try {
          var result = await api("/repos/" + OWNER + "/" + REPO + "/contents/" + encodePath(path), {
            method: "PUT",
            body: JSON.stringify(payload)
          });
          current = { path: path, sha: result.content.sha, slug: slug };
          $("slug").value = slug;
          $("slug").disabled = true;
          $("delete").hidden = false;
          $("cancel").hidden = false;
          $("view").hidden = false;
          $("view").href = base + "posts/" + encodeURIComponent(slug) + "/";
          var savedPost = {
            name: path.split("/").pop(),
            path: path,
            sha: result.content.sha,
            data: {
              title: title,
              description: $("description").value.trim(),
              date: date,
              tags: tags,
              draft: $("draft").checked
            },
            body: $("body").value
          };
          var existing = posts.findIndex(function (item) { return item.path === path; });
          if (existing >= 0) posts[existing] = savedPost;
          else posts.push(savedPost);
          posts.sort(function (a, b) {
            return String(b.data.date || "").localeCompare(String(a.data.date || ""));
          });
          renderList();
          setStatus("已保存，约 1 分钟后自动发布", "ok");
        } catch (e) {
          setStatus("保存失败：" + e.message, "err");
        }
      }

      async function deletePost() {
        if (!current) return;
        var title = $("title").value.trim() || current.slug;
        if (!confirm("确定删除《" + title + "》？这个操作不能撤销。")) return;
        setStatus("删除中…");
        try {
          await api("/repos/" + OWNER + "/" + REPO + "/contents/" + encodePath(current.path), {
            method: "DELETE",
            body: JSON.stringify({ message: "delete post: " + title, sha: current.sha, branch: BRANCH })
          });
          var removedPath = current.path;
          posts = posts.filter(function (item) { return item.path !== removedPath; });
          newPost();
          renderList();
          setStatus("已删除", "ok");
        } catch (e) {
          setStatus("删除失败：" + e.message, "err");
        }
      }

      async function connect() {
        var value = $("token").value.trim();
        if (!value) return setLoginStatus("先填 token", "err");
        token = value;
        setLoginStatus("验证中…");
        try {
          await api("/repos/" + OWNER + "/" + REPO);
          storeToken(value, $("remember").checked);
          $("token").value = "";
          showApp();
          await loadPosts();
        } catch (e) {
          token = "";
          setLoginStatus("连接失败：" + e.message, "err");
        }
      }

      function logout() {
        clearToken();
        current = null;
        posts = [];
        settingsLoaded = false;
        settingsSha = null;
        $("post-list").textContent = "";
        showLogin("已退出", "ok");
      }

      var SETTINGS_PATH = "src/data/site.json";
      var settingsSha = null;
      var settingsLoaded = false;

      function setSettingsStatus(message, tone) {
        var el = $("settings-status");
        if (!el) return;
        el.textContent = message || "";
        el.setAttribute("data-tone", tone || "");
      }

      function assetUrl(path) {
        path = path || "";
        return /^https?:/i.test(path) ? path : base + path.replace(/^\//, "");
      }

      function updateAssetPreviews() {
        var avatar = $("set-avatar").value.trim();
        var banner = $("set-banner").value.trim();
        var avatarImg = $("preview-avatar");
        var bannerImg = $("preview-banner");
        if (avatarImg) {
          avatarImg.src = avatar ? assetUrl(avatar) : "";
          avatarImg.style.display = avatar ? "block" : "none";
        }
        if (bannerImg) {
          bannerImg.src = banner ? assetUrl(banner) : "";
          bannerImg.style.display = banner ? "block" : "none";
        }
      }

      function fillSettings(settings) {
        $("set-title").value = settings.title || "";
        $("set-subtitle").value = settings.subtitle || "";
        $("set-description").value = settings.description || "";
        $("set-author").value = settings.author || "";
        $("set-bio").value = settings.bio || "";
        $("set-announcement").value = settings.announcement || "";
        $("set-about").value = settings.about || "";
        $("set-avatar").value = settings.avatar || "";
        $("set-banner").value = settings.banner || "";
        $("set-nav").value = (settings.nav || []).map(function (item) {
          return [item.label || "", item.url || ""].join("|");
        }).join("\n");
        $("set-socials").value = (settings.socials || []).map(function (item) {
          return [item.label || "", item.url || "", item.icon || "link"].join("|");
        }).join("\n");
        $("set-repos").value = (settings.repos || []).map(function (item) {
          return [item.full || "", item.desc || ""].join("|");
        }).join("\n");
        $("set-friends").value = (settings.friends || []).map(function (item) {
          return [item.name || "", item.url || "", item.avatar || "", item.desc || ""].join("|");
        }).join("\n");
        $("set-gallery").value = (settings.gallery || []).map(function (item) {
          return [item.src || "", item.caption || ""].join("|");
        }).join("\n");
        $("set-projects").value = (settings.projects || []).map(function (item) {
          return [item.name || "", item.url || "", item.desc || ""].join("|");
        }).join("\n");
        $("set-tracks").value = (settings.tracks || []).map(function (item) {
          return [item.title || "", item.artist || "", item.src || ""].join("|");
        }).join("\n");
        $("set-collection").value = (settings.collection || []).map(function (item) {
          return [item.type || "", item.title || "", item.note || "", item.url || ""].join("|");
        }).join("\n");
        updateAssetPreviews();
      }

      async function loadSettings() {
        setSettingsStatus("加载设置…");
        var data = await api("/repos/" + OWNER + "/" + REPO + "/contents/" + encodePath(SETTINGS_PATH) + "?ref=" + BRANCH);
        settingsSha = data.sha;
        fillSettings(JSON.parse(b64decode(data.content)));
        settingsLoaded = true;
        setSettingsStatus("设置已加载", "ok");
      }

      function parseSocials(text) {
        return text.split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean).map(function (line) {
          var parts = line.split("|").map(function (item) { return item.trim(); });
          return { label: parts[0] || "链接", url: parts[1] || "", icon: parts[2] || "link" };
        }).filter(function (item) { return item.url; });
      }

      function parseNav(text) {
        return text.split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean).map(function (line) {
          var parts = line.split("|").map(function (item) { return item.trim(); });
          return { label: parts[0] || "", url: parts[1] || "/" };
        }).filter(function (item) { return item.label; });
      }

      function parseTracks(text) {
        return text.split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean).map(function (line) {
          var parts = line.split("|").map(function (item) { return item.trim(); });
          return { title: parts[0] || "未命名", artist: parts[1] || "", src: parts[2] || "" };
        }).filter(function (item) { return item.src; });
      }

      function parseCollection(text) {
        return text.split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean).map(function (line) {
          var parts = line.split("|").map(function (item) { return item.trim(); });
          return { type: parts[0] || "其他", title: parts[1] || "", note: parts[2] || "", url: parts[3] || "#" };
        }).filter(function (item) { return item.title; });
      }

      function parseFriends(text) {
        return text.split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean).map(function (line) {
          var parts = line.split("|").map(function (item) { return item.trim(); });
          return { name: parts[0] || "", url: parts[1] || "", avatar: parts[2] || "/avatar.svg", desc: parts[3] || "" };
        }).filter(function (item) { return item.name && item.url; });
      }

      function parseGallery(text) {
        return text.split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean).map(function (line) {
          var parts = line.split("|").map(function (item) { return item.trim(); });
          return { src: parts[0] || "", caption: parts[1] || "" };
        }).filter(function (item) { return item.src; });
      }

      function parseProjects(text) {
        return text.split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean).map(function (line) {
          var parts = line.split("|").map(function (item) { return item.trim(); });
          return { name: parts[0] || "", url: parts[1] || "", desc: parts[2] || "" };
        }).filter(function (item) { return item.name && item.url; });
      }

      function parseRepos(text) {
        return text.split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean).map(function (line) {
          var parts = line.split("|").map(function (item) { return item.trim(); });
          return { full: parts[0] || "", desc: parts[1] || "" };
        }).filter(function (item) { return item.full; });
      }

      async function saveSettings(event) {
        event.preventDefault();
        if (!settingsLoaded) {
          return setSettingsStatus("设置还没加载成功，先点「站点设置」重新加载", "err");
        }
        var title = $("set-title").value.trim();
        if (!title) return setSettingsStatus("站点标题不能为空", "err");
        var settings = {
          title: title,
          subtitle: $("set-subtitle").value.trim(),
          description: $("set-description").value.trim(),
          author: $("set-author").value.trim() || "SorenX",
          bio: $("set-bio").value,
          announcement: $("set-announcement").value,
          about: $("set-about").value,
          banner: $("set-banner").value.trim() || "/banner.svg",
          avatar: $("set-avatar").value.trim() || "/avatar.svg",
          nav: parseNav($("set-nav").value),
          socials: parseSocials($("set-socials").value),
          friends: parseFriends($("set-friends").value),
          gallery: parseGallery($("set-gallery").value),
          projects: parseProjects($("set-projects").value),
          tracks: parseTracks($("set-tracks").value),
          collection: parseCollection($("set-collection").value),
          repos: parseRepos($("set-repos").value)
        };
        var payload = {
          message: "Update site settings",
          content: b64encode(JSON.stringify(settings, null, 2) + "\n"),
          branch: BRANCH
        };
        if (settingsSha) payload.sha = settingsSha;
        setSettingsStatus("保存中…");
        try {
          var result = await api("/repos/" + OWNER + "/" + REPO + "/contents/" + encodePath(SETTINGS_PATH), {
            method: "PUT",
            body: JSON.stringify(payload)
          });
          settingsSha = result.content.sha;
          setSettingsStatus("设置已保存，约 1 分钟上线", "ok");
        } catch (e) {
          setSettingsStatus("保存失败：" + e.message, "err");
        }
      }

      function readFileAsDataUrl(file) {
        return new Promise(function (resolve, reject) {
          var reader = new FileReader();
          reader.onload = function () { resolve(String(reader.result)); };
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      }

      async function uploadImage(field, file) {
        var ext = (file.name.split(".").pop() || "jpg").toLowerCase().replace(/[^a-z0-9]/g, "") || "jpg";
        var filename = field + "-" + Date.now() + "." + ext;
        var path = "public/uploads/" + filename;
        setSettingsStatus("上传中…");
        var dataUrl = await readFileAsDataUrl(file);
        var base64 = dataUrl.split(",")[1] || "";
        await api("/repos/" + OWNER + "/" + REPO + "/contents/" + encodePath(path), {
          method: "PUT",
          body: JSON.stringify({ message: "upload " + field, content: base64, branch: BRANCH })
        });
        var value = "/uploads/" + filename;
        if (field === "gallery") {
          var galleryField = $("set-gallery");
          galleryField.value = (galleryField.value.trim() ? galleryField.value.trim() + "\n" : "") + value + "|";
          setSettingsStatus("相册图片已上传，记得填写说明并保存设置", "ok");
          return;
        }
        $(field === "avatar" ? "set-avatar" : "set-banner").value = value;
        updateAssetPreviews();
        setSettingsStatus("图片已上传，记得保存设置", "ok");
      }

      async function uploadAudio(file) {
        var ext = (file.name.split(".").pop() || "mp3").toLowerCase().replace(/[^a-z0-9]/g, "") || "mp3";
        var filename = "audio-" + Date.now() + "." + ext;
        var path = "public/music/" + filename;
        setSettingsStatus("上传中…");
        var dataUrl = await readFileAsDataUrl(file);
        var base64 = dataUrl.split(",")[1] || "";
        await api("/repos/" + OWNER + "/" + REPO + "/contents/" + encodePath(path), {
          method: "PUT",
          body: JSON.stringify({ message: "upload audio", content: base64, branch: BRANCH })
        });
        var value = "/music/" + filename;
        var field = $("set-tracks");
        field.value = (field.value.trim() ? field.value.trim() + "\n" : "") + "新音频||" + value;
        setSettingsStatus("音频已上传，记得填标题和歌手并保存设置", "ok");
      }

      document.querySelectorAll("[data-upload]").forEach(function (input) {
        input.addEventListener("change", async function () {
          var file = input.files && input.files[0];
          if (!file) return;
          try {
            var field = input.getAttribute("data-upload");
            if (field === "audio") await uploadAudio(file);
            else await uploadImage(field, file);
          } catch (e) {
            setSettingsStatus("上传失败：" + e.message, "err");
          } finally {
            input.value = "";
          }
        });
      });

      $("set-avatar").addEventListener("input", updateAssetPreviews);
      $("set-banner").addEventListener("input", updateAssetPreviews);
      $("settings-form").addEventListener("submit", saveSettings);

      document.querySelectorAll("[data-admin-tab]").forEach(function (tab) {
        tab.addEventListener("click", function () {
          var name = tab.getAttribute("data-admin-tab");
          document.querySelectorAll("[data-admin-tab]").forEach(function (item) { item.classList.remove("active"); });
          tab.classList.add("active");
          document.querySelectorAll("[data-admin-panel]").forEach(function (panel) {
            panel.hidden = panel.getAttribute("data-admin-panel") !== name;
          });
          if (name === "settings" && !settingsLoaded) {
            loadSettings().catch(function (e) { setSettingsStatus("加载失败：" + e.message, "err"); });
          }
        });
      });

      $("connect").addEventListener("click", connect);
      $("logout").addEventListener("click", logout);
      $("new").addEventListener("click", newPost);
      $("refresh").addEventListener("click", function () { loadPosts().catch(function (e) { setStatus("刷新失败：" + e.message, "err"); }); });
      $("form").addEventListener("submit", savePost);
      $("delete").addEventListener("click", deletePost);
      $("cancel").addEventListener("click", newPost);
      $("title").addEventListener("input", function () {
        if (!current && !slugTouched) {
          $("slug").value = slugify($("title").value);
        }
      });
      $("slug").addEventListener("input", function () { slugTouched = true; });

      var stored = getStoredToken();
      if (stored) {
        token = stored;
        setLoginStatus("正在用已保存的 token 连接…");
        api("/repos/" + OWNER + "/" + REPO)
          .then(function () {
            showApp();
            return loadPosts();
          })
          .catch(function (e) {
            clearToken();
            showLogin("保存的 token 失效了，请重新填：" + e.message, "err");
          });
      } else {
        showLogin("", "");
      }
    })();
  </script>
</BaseLayout>
